{
  "permissions": {
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)",
      "Bash(git tag:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git apply:*)",
      "Bash(git am:*)",
      "Bash(git rm:*)",
      "Bash(git prune:*)",
      "Bash(git gc:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)"
    ],
    "allow": [
      "Bash({{cli-claude}}:*)",
      "Bash({{cli-codex}}:*)",
      "Bash({{cli-opencode}}:*)",
      "Bash({{commande-ci}}:*)"
    ]
  }
}
