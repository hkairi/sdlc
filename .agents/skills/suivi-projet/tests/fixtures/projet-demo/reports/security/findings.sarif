{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "rules": [
            { "id": "py.sql-injection", "defaultConfiguration": { "level": "error" } }
          ]
        }
      },
      "results": [
        {
          "ruleId": "py.sql-injection",
          "level": "error",
          "properties": { "security-severity": "9.5" },
          "message": { "text": "Injection SQL possible" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "api/handler.py" },
                "region": { "startLine": 42 }
              }
            }
          ]
        }
      ]
    },
    {
      "tool": { "driver": { "name": "Trivy" } },
      "results": [
        {
          "ruleId": "CVE-2026-0001",
          "level": "warning",
          "properties": { "security-severity": "7.2" },
          "message": { "text": "Dépendance vulnérable" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "web/package-lock.json" },
                "region": { "startLine": 10 }
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2026-0002",
          "level": "warning",
          "message": { "text": "Sans security-severity : niveau warning" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "api/requirements.txt" },
                "region": { "startLine": 3 }
              }
            }
          ]
        }
      ]
    }
  ]
}
