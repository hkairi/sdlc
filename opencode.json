{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "**/secrets/**": "deny"
    },
    "bash": {
      "*": "allow",
      "git *": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "curl * | sh*": "deny",
      "curl * | bash*": "deny",
      "git branch --show-current*": "allow"
    },
    "external_directory": "deny",
    "webfetch": "allow"
  }
}
